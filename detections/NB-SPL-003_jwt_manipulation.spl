index=* source="/var/log/nginx/access.log"

| rex field=_raw
    "Authorization:\s+Bearer\s+(?P<jwt_token>[A-Za-z0-9\-_]+\.[A-Za-z0-9\-_]+\.[A-Za-z0-9\-_]*)"

| where isnotnull(jwt_token)

| eval
    jwt_header  = lower(mvindex(split(jwt_token, "."), 0)),
    is_none_alg = if(match(jwt_header, "(?i)\"alg\"\s*:\s*\"none\""),
                    "YES", "NO"),
    is_weak_alg = if(match(jwt_header, "(?i)\"alg\"\s*:\s*\"hs(256|384|512)\""),
                    "YES", "NO"),
    attack_time = strftime(_time, "%Y-%m-%d %H:%M:%S")

| stats
    count                   as request_count,
    values(is_none_alg)     as none_alg_attempts,
    values(is_weak_alg)     as weak_alg_used,
    values(uri)             as targeted_endpoints,
    values(status)          as responses,
    first(attack_time)      as first_seen,
    last(attack_time)       as last_seen
    by src_ip, http_user_agent

| eval
    attack_type = case(
        mvindex(none_alg_attempts, 0) == "YES",
            "JWT None Algorithm Attack - KRITIK",
        request_count >= 50,
            "JWT Brute Force",
        mvindex(weak_alg_used, 0) == "YES" AND request_count >= 20,
            "JWT Weak Algorithm Exploitation",
        true(),
            "JWT Anomaly"),

    severity = case(
        mvindex(none_alg_attempts, 0) == "YES", "CRITICAL",
        request_count >= 50,                    "HIGH",
        true(),                                 "MEDIUM"),

    mitre_id        = "T1550.001",
    mitre_technique = "Use Alternate Authentication Material",
    mitre_tactic    = "TA0008 - Lateral Movement",
    rule_id         = "NB-SPL-003",

    remediation     = "
        1. Flask-da alg=none-u derhral red et: jwt.decode(token,key,algorithms=['RS256']) |
        2. Subheli token-i blacklist-e elave et: redis.set(blacklist:TOKEN, 1, ex=3600) |
        3. Hemin istifadecinin butun sessionlarini sonlandir |
        4. JWT secret-i rotate et - yeni secret yarat |
        5. Loqlarda hemin token ile ne edildiyini yoxla"

| where severity IN ("HIGH", "CRITICAL")

| table
    attack_time, src_ip, request_count, attack_type,
    severity, targeted_endpoints, none_alg_attempts,
    first_seen, last_seen,
    mitre_id, rule_id, remediation

| sort - severity
