index=* source="/var/log/nginx/access.log"
| stats count as request_count, values(uri) as targeted_endpoints, values(status) as responses by clientip, useragent
| where request_count >= 20
| eval
    attack_type=case(
        request_count>=100, "JWT Brute Force - High Volume",
        request_count>=50,  "JWT Brute Force - Medium",
        true(),             "JWT None Algorithm Attack"),
    severity=case(
        request_count>=100, "CRITICAL",
        request_count>=50,  "HIGH",
        true(),             "MEDIUM"),
    mitre_id="T1550.001",
    mitre_technique="Use Alternate Authentication Material",
    mitre_tactic="TA0008 - Lateral Movement",
    rule_id="NB-SPL-003",
    remediation="1. alg=none red et: algorithms=['RS256'] | 2. Token blacklist-e elave et | 3. Sessionlari sonlandir | 4. Secret rotate et"
| where severity IN ("HIGH","CRITICAL")
| table clientip, request_count, attack_type, severity,
    targeted_endpoints, mitre_id, rule_id, remediation
| sort - request_count
