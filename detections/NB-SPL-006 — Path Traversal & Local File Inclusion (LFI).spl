index=* source="/var/log/nginx/access.log"
| rex field=uri "(?i)(?P<lfi_pattern>(\.\.\/|\.\.\\|\%2e\%2e\%2f|\%2e\%2e\%5c|etc\/passwd|boot\.ini|windows\/win\.ini))"
| where isnotnull(lfi_pattern)
| bucket _time span=5m
| stats 
    count as attempt_count,
    values(lfi_pattern) as payloads,
    values(uri) as targeted_uris,
    values(status) as http_responses,
    earliest(_time) as window_start_epoch,
    latest(_time) as window_end_epoch
    by _time, clientip, useragent
| eval 
    window_start = strftime(window_start_epoch, "%Y-%m-%d %H:%M:%S"),
    window_end = strftime(window_end_epoch, "%Y-%m-%d %H:%M:%S"),
    is_successful = if(match(mvjoin(http_responses, " "), "200"), "YES", "NO"),
    attack_type = case(
        is_successful == "YES", "Successful LFI / Sensitive Data Read",
        attempt_count >= 20, "Aggressive Path Traversal Scanning",
        1==1, "Path Traversal Attempt"
    ),
    severity = case(
        is_successful == "YES", "CRITICAL",
        attempt_count >= 20, "HIGH",
        1==1, "MEDIUM"
    ),
    mitre_id = "T1083",
    mitre_technique = "File and Directory Discovery",
    mitre_tactic = "TA0007 - Discovery",
    rule_id = "NB-SPL-006",
    recommended_action = "1. Block source IP | 2. Verify if sensitive files (e.g., /etc/passwd) were actually read | 3. Implement strict input validation & chroot jails"
| where severity IN ("MEDIUM", "HIGH", "CRITICAL")
| table window_start, window_end, clientip, attempt_count, is_successful, attack_type, severity, payloads, targeted_uris, http_responses, mitre_id, rule_id, recommended_action
| sort - severity, - attempt_count
