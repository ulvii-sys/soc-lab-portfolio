index=* source="/var/log/nginx/access.log"
| rex field=uri "(?i)(?P<sqli>UNION|union|information_schema|pg_sleep|pg_tables|drop|insert)"
| where isnotnull(sqli)
| bucket _time span=5m
| stats
    count                   as attempt_count,
    values(sqli)            as patterns,
    values(uri)             as targeted_uris,
    values(status)          as http_responses
    by _time, clientip, useragent
| where attempt_count >= 3
| eval
    severity=case(
        attempt_count>=20, "CRITICAL",
        attempt_count>=10, "HIGH",
        true(),            "MEDIUM"),
    mitre_id="T1190",
    mitre_technique="Exploit Public-Facing Application",
    mitre_tactic="TA0001 - Initial Access",
    rule_id="NB-SPL-001",
    remediation="1. clientip blokla: sudo ufw deny from CLIENTIP | 2. PostgreSQL loglarini yoxla: SELECT * FROM pg_stat_activity | 3. Prepared statement istifade et | 4. Backup yoxla"
| where severity IN ("HIGH","CRITICAL")
| table _time, clientip, attempt_count, severity,
    patterns, targeted_uris, http_responses,
    mitre_id, mitre_technique, rule_id, remediation
| sort - attempt_count
