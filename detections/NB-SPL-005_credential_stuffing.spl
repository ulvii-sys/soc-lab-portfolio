index=web_logs host="novruzbank.site"
| rex field=uri "(?i)(?P<ssti_pattern>(\{\{.*\}\})|(\{%.*%\})|(\$\{.*\})|(__class__)|(__mro__)|(__subclasses__)|(__globals__)|(__builtins__)|(request\.environ)|(config\.items)|(lipsum|cycler|joiner|namespace))"
| where isnotnull(ssti_pattern)
| eval attack_time=strftime(_time,"%Y-%m-%d %H:%M:%S")
| stats count as attempt_count, values(ssti_pattern) as payloads, values(uri) as targeted_uris, values(status) as http_responses, first(attack_time) as first_seen, last(attack_time) as last_seen by src_ip, http_user_agent
| eval rce_risk=if(match(mvjoin(payloads," "),"(?i)__class__|__mro__|__subclasses__|__globals__|__builtins__"),"YUKSEK - RCE Mumkundur!","ASAGI"), severity=case(rce_risk=="YUKSEK - RCE Mumkundur!","CRITICAL",attempt_count>=5,"HIGH",true(),"MEDIUM"), mitre_id="T1059", mitre_technique="Command and Scripting Interpreter", mitre_tactic="TA0002 - Execution", rule_id="NB-SPL-004", remediation="1. DERHRAL src_ip blokla - RCE riski var: sudo ufw deny from SRC_IP | 2. Serverde subheli prosesleri yoxla: ps aux | grep python | 3. Jinja2 sandbox aktiv et: from jinja2.sandbox import SandboxedEnvironment | 4. render_template_string(user_input) istifadesini render_template() ile evez et"
| where severity IN ("HIGH","CRITICAL")
| table attack_time, src_ip, attempt_count, rce_risk, severity, payloads, targeted_uris, http_responses, first_seen, last_seen, mitre_id, rule_id, remediation
| sort - severity
