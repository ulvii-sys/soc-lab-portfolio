index=* source="/var/log/nginx/access.log"
    (uri="/login" OR uri="/api/login" OR uri="/auth" OR uri="/api/token" OR uri="/api/auth")
| eval
    status_code=tonumber(status),
    attack_time=strftime(_time,"%Y-%m-%d %H:%M:%S")
| bucket _time span=5m
| stats
    count                               as total_requests,
    sum(eval(status_code=401))          as failed_logins,
    sum(eval(status_code=200))          as successful_logins,
    sum(eval(status_code=403))          as blocked_attempts,
    dc(useragent)                       as unique_agents,
    values(useragent)                   as agents,
    first(attack_time)                  as window_start,
    last(attack_time)                   as window_end
    by _time, clientip
| where failed_logins>=10 OR blocked_attempts>=10
| eval
    account_takeover=if(successful_logins>0 AND failed_logins>=10,
        "KRITIK - HESAB ELE KECIRILDI!","XEYR"),
    attack_type=case(
        account_takeover=="KRITIK - HESAB ELE KECIRILDI!", "Credential Stuffing - Ugurlu Giris",
        unique_agents>=5, "Distributed Brute Force",
        failed_logins>=50 OR blocked_attempts>=50, "High Volume Brute Force",
        true(), "Brute Force Attempt"),
    severity=case(
        account_takeover=="KRITIK - HESAB ELE KECIRILDI!", "CRITICAL",
        failed_logins>=50 OR blocked_attempts>=50, "HIGH",
        true(), "MEDIUM"),
    mitre_id="T1110.004",
    mitre_technique="Credential Stuffing",
    mitre_tactic="TA0006 - Credential Access",
    rule_id="NB-SPL-005",
    remediation="1. clientip-ni blokla ve butun sessionlari sonlandir | 2. Ugurlu giris oldusa istifadeciye email gonder | 3. Hesabin parolunu sifirla | 4. CAPTCHA elave et | 5. MFA aktiv et: pyotp library"
| where severity IN ("MEDIUM","HIGH","CRITICAL")
| table
    window_start, window_end, clientip,
    failed_logins, successful_logins, blocked_attempts,
    account_takeover, attack_type, severity,
    unique_agents, total_requests,
    mitre_id, rule_id, remediation
| sort - severity
