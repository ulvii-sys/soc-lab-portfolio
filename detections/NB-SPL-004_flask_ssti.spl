index=* source="/var/log/nginx/access.log"
uri="/register"
| bucket _time span=5m
| stats
    count                   as attempt_count,
    values(status)          as responses,
    dc(useragent)           as unique_agents,
    values(useragent)       as agents
    by _time, clientip
| where attempt_count >= 5
| eval
    is_bot=if(match(mvjoin(agents," "),"(?i)curl|python|wget|scanner"),"YES","NO"),
    attack_type=case(
        is_bot=="YES" AND attempt_count>=10, "SSTI Attempt - Automated Tool",
        is_bot=="YES",                        "SSTI Bot Detected",
        attempt_count>=20,                    "SSTI High Volume",
        true(),                               "SSTI Suspicious Registration"),
    severity=case(
        is_bot=="YES" AND attempt_count>=10, "CRITICAL",
        is_bot=="YES",                        "HIGH",
        attempt_count>=20,                    "HIGH",
        true(),                               "MEDIUM"),
    mitre_id="T1059",
    mitre_technique="Command and Scripting Interpreter",
    mitre_tactic="TA0002 - Execution",
    rule_id="NB-SPL-004",
    remediation="1. clientip blokla | 2. Jinja2 sandbox aktiv et | 3. render_template_string evez et | 4. Input validation elave et"
| where severity IN ("HIGH","CRITICAL")
| table
    _time, clientip, attempt_count, is_bot,
    attack_type, severity, agents,
    mitre_id, mitre_technique, rule_id, remediation
| sort - attempt_count
